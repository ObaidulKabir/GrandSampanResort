// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Suite {
  id          String  @id
  floor       Int
  type        String
  size        Int
  view        String
  totalPrice  Int
  currency    String?
  plans       SharePlan[]
}

model SharePlan {
  id           String  @id
  name         String
  daysPerMonth Int
  lockIn       Int
  price        Int
  currency     String?
  suiteId      String?
  planStatus   String?
  planType     String?
  timeFraction Float?
  suite        Suite?  @relation(fields: [suiteId], references: [id])
  bookings     Booking[]
}

model Booking {
  id          String  @id
  suiteId     String
  planId      String?
  investorId  String?
  /// KYC snapshot for the person this investment is booked for (null for guest stays).
  clientId    String?
  start       DateTime
  end         DateTime
  status      String
  amountTotal Int?
  /// Offline deposit: cheque | cash_payorder | online_transfer
  depositMethod      String?
  depositReference   String?
  depositProofUrl    String?
  depositNote        String?
  depositSubmittedAt DateTime?
  /// Set when admin confirms cash receipt / bank encashment.
  depositConfirmedAt DateTime?
  /// Set when admin verifies per-booking KYC snapshot is valid.
  kycVerified   Boolean  @default(false)
  kycVerifiedAt DateTime?
  /// Admin cancellation reason (required when status becomes cancelled).
  cancellationReason String?
  cancelledAt        DateTime?
  /// When the booking was placed (submission time).
  createdAt   DateTime @default(now())
  /// Referral code captured at purchase (optional).
  referralCode     String?
  /// Referrer user id resolved from referralCode at purchase.
  referredByUserId String?
  /// List price before promo / advance discounts (investment bookings).
  listPrice            Int?
  promoDiscountPct     Float?
  promoName            String?
  advanceDiscountPct   Float?
  paymentTierId        String?
  installmentMonths    Int?
  cadence              String?
  discountRateAnnualPct Float?
  schedule    PaymentScheduleItem[]
  /// Investment purchases link to a share plan; guest stays leave this null.
  plan        SharePlan? @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  referralReward ReferralReward?
}

model PaymentScheduleItem {
  id         String  @id
  bookingId  String
  type       String
  dueDate    DateTime
  amount     Int
  status     String
  gatewayRef String?
  booking    Booking @relation(fields: [bookingId], references: [id])
}

model Client {
  id               String    @id
  name             String
  fatherName       String
  nid              String
  dob              String
  address          String
  permanentAddress String
  contact          String
  email            String
  picUrl           String
  profession       String   @default("")
  city             String   @default("")
  nomineeName      String
  nomineeNid       String
  nomineePicUrl    String
  bookings         Booking[]
}

model User {
  id           String   @id
  name         String
  email        String   @unique
  passwordHash String
  kyc          Boolean  @default(false)
  /// Soft gate: login allowed; investment booking blocked until true.
  emailVerified       Boolean   @default(false)
  emailVerifyToken    String?
  emailVerifyExpires  DateTime?
  passwordResetToken  String?
  passwordResetExpires DateTime?
  role         String   @default("investor")
  /// Unique shareable referral code for this account.
  referralCode String?  @unique
  /// User who referred this account at registration (optional).
  referredById String?
  /// Optional per-referrer commission override (% of sale). Null = use global policy.
  referralIncentivePct Float?
  createdAt    DateTime @default(now())
  referralRewards ReferralReward[] @relation("ReferrerRewards")
}

model ReferralReward {
  id              String    @id
  referrerId      String
  bookingId       String    @unique
  buyerId         String?
  saleAmount      Int
  ratePct         Float
  totalIncentive  Int
  /// 40% unlocked when booking is confirmed.
  tranche1Amount  Int
  tranche1Status  String    @default("pending")
  tranche1EarnedAt DateTime?
  /// 60% unlocked when downpayment schedule item is paid.
  tranche2Amount  Int
  tranche2Status  String    @default("pending")
  tranche2EarnedAt DateTime?
  /// overall: pending | partial | earned | paid | void
  status          String    @default("pending")
  paidAt          DateTime?
  voidReason      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  referrer        User      @relation("ReferrerRewards", fields: [referrerId], references: [id], onDelete: Restrict)
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model MediaAsset {
  id        String   @id
  category  String
  label     String?
  suiteId   String?
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model FaqEntry {
  id         String   @id
  question   String
  answer     String
  questionBn String?
  answerBn   String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TermsParagraph {
  id        String   @id
  title     String
  body      String
  titleBn   String?
  bodyBn    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Promotion {
  id          String   @id
  name        String
  discountPct Int
  scope       String
  suiteTypes  String[] @default([])
  planIds     String[] @default([])
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
