// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Suite {
  id          String  @id
  floor       Int
  type        String
  size        Int
  view        String
  totalPrice  Int
  currency    String?
  plans       SharePlan[]
}

model SharePlan {
  id           String  @id
  name         String
  daysPerMonth Int
  lockIn       Int
  price        Int
  currency     String?
  suiteId      String?
  planStatus   String?
  planType     String?
  timeFraction Float?
  suite        Suite?  @relation(fields: [suiteId], references: [id])
}

model Booking {
  id          String  @id
  suiteId     String
  planId      String?
  investorId  String?
  start       DateTime
  end         DateTime
  status      String
  amountTotal Int?
  schedule    PaymentScheduleItem[]
}

model PaymentScheduleItem {
  id         String  @id
  bookingId  String
  type       String
  dueDate    DateTime
  amount     Int
  status     String
  gatewayRef String?
  booking    Booking @relation(fields: [bookingId], references: [id])
}

model Client {
  id               String @id
  name             String
  fatherName       String
  nid              String
  dob              String
  address          String
  permanentAddress String
  contact          String
  email            String
  picUrl           String
  nomineeName      String
  nomineeNid       String
  nomineePicUrl    String
}

model User {
  id           String   @id
  name         String
  email        String   @unique
  passwordHash String
  kyc          Boolean  @default(false)
  role         String   @default("investor")
  createdAt    DateTime @default(now())
}

model MediaAsset {
  id        String   @id
  category  String
  label     String?
  suiteId   String?
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model FaqEntry {
  id        String   @id
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TermsParagraph {
  id        String   @id
  title     String
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Promotion {
  id          String   @id
  name        String
  discountPct Int
  scope       String
  suiteTypes  String[] @default([])
  planIds     String[] @default([])
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
