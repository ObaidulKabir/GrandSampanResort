datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}
enum Role {
  ADMIN
  INVESTOR
}
model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  role         Role
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  bookings     Booking[]      @relation("InvestorBookings")
}
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Suite {
  id          String  @id
  floor       Int
  type        String
  size        Int
  view        String
  totalPrice  Int
  currency    String?
  planImage   String?
  layoutImage String?
  viewImages  String[]
  plans       SharePlan[]
}
model SharePlan {
  id                 String  @id
  name               String
  daysPerMonth       Int
  lockIn             Int
  price              Int
  currency           String?
  suiteId            String?
  planStatus         String?
  planType           String?
  timeFraction       Float?
  suite              Suite?  @relation(fields: [suiteId], references: [id])
}
model Booking {
  id          String  @id
  suiteId     String
  planId      String?
  investorId  String?
  investor    User?   @relation("InvestorBookings", fields: [investorId], references: [id], onDelete: SetNull)
  start       DateTime
  end         DateTime
  status      String
  amountTotal Int?
  schedule    PaymentScheduleItem[]
}
model PaymentScheduleItem {
  id         String  @id
  bookingId  String
  type       String
  dueDate    DateTime
  amount     Int
  status     String
  gatewayRef String?
  booking    Booking @relation(fields: [bookingId], references: [id])
}
model Client {
  id               String @id
  name             String
  fatherName       String
  nid              String
  dob              String
  address          String
  permanentAddress String
  contact          String
  email            String
  picUrl           String
  nomineeName      String
  nomineeNid       String
  nomineePicUrl    String
}

