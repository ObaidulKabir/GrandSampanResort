NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://backend:4000
DATABASE_URL=postgresql://app:app@db:5432/grand_sampan
JWT_SECRET=change-me-in-production

# Public site URL used in notification emails
PUBLIC_SITE_URL=https://www.grandsampanresort.com

# Zoho Mail SMTP — use an App Password if 2FA is on.
# Paid org / custom domain: smtppro.zoho.com | Free/personal: smtp.zoho.com
# Prefer either SMTP_PORT=465 (SSL) or SMTP_PORT=587 (STARTTLS).
# Do not use SMTP_SECURE=true with port 587.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@grandsampanresort.com
SMTP_PASS=
MAIL_FROM=Grand Sampan Resort <admin@grandsampanresort.com>
# Optional: BCC a copy of every transactional email to ops
MAIL_BCC=admin@grandsampanresort.com
PGADMIN_DEFAULT_EMAIL=admin@grandsampanresort.com
PGADMIN_DEFAULT_PASSWORD=change-me-in-production
